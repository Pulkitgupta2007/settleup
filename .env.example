# ==============================================================================
# SettleUp - Environment Configuration Template
# Copy this file to .env.local for local development.
# Configure these in your Vercel project settings for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas or Local Replica Set)
# ------------------------------------------------------------------------------
# For Atlas Free Tier (M0):
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/settleup?retryWrites=true&w=majority"
# For Local standalone development (Note: multi-document transactions require replica set):
# MONGODB_URI="mongodb://127.0.0.1:27017/settleup"
MONGODB_URI="mongodb://127.0.0.1:27017/settleup"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 32-character random string using:
# $ openssl rand -base64 32
NEXTAUTH_SECRET="settleup-dev-jwt-secret-very-secure-key-32chars"

# Canonical URL of the application.
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Optional)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI:
#   Local: http://localhost:3000/api/auth/callback/google
#   Production: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. FOREIGN EXCHANGE (FX) API (Optional)
# ------------------------------------------------------------------------------
# SettleUp uses the free, keyless open.er-api.com by default.
# If you upgrade to a keyed provider (e.g., ExchangeRate-API or Fixer), add:
# EXCHANGE_RATE_API_KEY=""
